# Global InnerLink Fleet Configuration
# Change these values and run `./start.sh` to apply changes.

# ── Timezone ─────────────────────────────────────────────────────────────────
# IANA timezone name applied to all service containers (affects log timestamps).
TZ=Asia/Jerusalem

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# LOG_FORMAT: TEXT (Human-readable boxed tables), JSON (Structured for aggregators)
LOG_FORMAT=TEXT

# ── Security ─────────────────────────────────────────────────────────────────
# X-API-Key header required on all REST and WebSocket endpoints.
# Use a strong random string in production. Never commit real keys to git.
INTERNAL_API_KEY=il-9fA3mK7wXrPq2nZeVtYs

# ── User Auth (JWT) ───────────────────────────────────────────────────────────
# Change JWT_SECRET to a strong random string in production. Never commit real secrets.
JWT_SECRET=innerlink-jwt-dev-secret-change-this-in-production
JWT_EXPIRY_HOURS=24
# The username that automatically receives the admin role on registration.
ADMIN_USERNAME=admin

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per client per window (per RATE_LIMIT_WINDOW seconds).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# ── Meta-Learner Training ─────────────────────────────────────────────────────
# How often (seconds) the background retrainer triggers.
RETRAIN_INTERVAL_SECONDS=1800

# Minimum test accuracy required before deploying a new model.
# Set to 0.25 — appropriate for real multi-class empathetic prediction (3× above random).
# The old 0.40 was calibrated on GoEmotions circular bias, not genuine classification.
ACCURACY_GATE=0.25

# Bootstrap: max samples from EmpatheticDialogues used on first run (no model yet).
# Full dataset is ~23 000 rows; set lower to speed up initial boot.
MAX_EMPATHETIC_SAMPLES=23000

# Continuous learning: min verified DB samples needed to trigger a retrain cycle.
MIN_DB_SAMPLES=50

# Path where the trained model pkl is stored (inside the container).
MODEL_PATH=/app/models/meta_weights.pkl

# ── LLM Provider ─────────────────────────────────────────────────────────────
# LLM_PROVIDER: RULE_BASED (default, deterministic), OPENAI, GROQ (future)
LLM_PROVIDER=RULE_BASED

# ── Synthetic Data Generation ─────────────────────────────────────────────────
# Used by the trainer at bootstrap to generate sentences for missing GoEmotions classes.
# Claude Haiku (claude-haiku-4-5-20251001) is called once; result cached in models/.
ANTHROPIC_API_KEY=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
