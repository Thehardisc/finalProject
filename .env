# Global InnerLink Fleet Configuration
# Change these values and run `./start.sh` to apply changes.

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# LOG_FORMAT: TEXT (Human-readable boxed tables), JSON (Structured for aggregators)
LOG_FORMAT=TEXT

# ── Security ─────────────────────────────────────────────────────────────────
# X-API-Key header required on all REST and WebSocket endpoints.
# Use a strong random string in production. Never commit real keys to git.
INTERNAL_API_KEY=il-9fA3mK7wXrPq2nZeVtYs

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per client per window (per RATE_LIMIT_WINDOW seconds).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# ── Meta-Learner Training ─────────────────────────────────────────────────────
# How often (seconds) the background retrainer triggers.
RETRAIN_INTERVAL_SECONDS=1800

# Minimum test accuracy on GoEmotions required before deploying a new model.
ACCURACY_GATE=0.40

# Max samples used from GoEmotions per training run (larger = slower + better).
MAX_SAMPLES=10000
# Path where the trained model pkl is stored (inside the container).
MODEL_PATH=/app/models/meta_weights.pkl

# ── LLM Provider ─────────────────────────────────────────────────────────────
# LLM_PROVIDER: RULE_BASED (default, deterministic), OPENAI, GROQ (future)
LLM_PROVIDER=RULE_BASED
