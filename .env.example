# InnerLink Fleet Configuration — EXAMPLE FILE
# Copy this to .env and fill in your values before running `./start.sh`
# The .env file is gitignored and must NEVER be committed.

# ── Runtime ───────────────────────────────────────────────────────────────────
# Container timezone for log timestamps.
TZ=Asia/Jerusalem

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=TEXT

# ── Security ──────────────────────────────────────────────────────────────────
# Internal API key required by ingestion/api services (X-API-Key header).
# Generate with: python -c "import secrets; print('il-' + secrets.token_urlsafe(16))"
INTERNAL_API_KEY=your-strong-random-key-here

# JWT signing secret for user auth. ROTATE in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-me-with-a-real-secret
JWT_EXPIRY_HOURS=24

# Username (email) that gets auto-granted admin role on registration.
ADMIN_USERNAME=admin@demo.innerlink

# CORS allowlist — comma-separated. Both ingestion_service and api_service
# read this. For production, set to your hosted origin(s).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost,http://127.0.0.1,http://127.0.0.1:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# ── Datastores ────────────────────────────────────────────────────────────────
# Redis password — leave empty for dev (no auth).
REDIS_PASSWORD=

# Postgres connection (matches docker-compose.yml `db` service defaults).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=emotion_db
DB_HOST=db

# ── Training Config ───────────────────────────────────────────────────────────
RETRAIN_INTERVAL_SECONDS=1800
ACCURACY_GATE=0.40

# Bootstrap dataset size — EmpatheticDialogues rows used on first run.
MAX_EMPATHETIC_SAMPLES=25000

# Min verified DB samples needed before a continuous-learning cycle runs.
MIN_DB_SAMPLES=50

MODEL_PATH=/app/models/meta_weights.pkl

# ── LLM Settings ──────────────────────────────────────────────────────────────
# Options: RULE_BASED (default), ANTHROPIC, OPENAI, GROQ
LLM_PROVIDER=RULE_BASED

# Anthropic API key — required when LLM_PROVIDER=ANTHROPIC or for training data generation.
ANTHROPIC_API_KEY=

# Claude model for real-time emotion insights in llm_reasoning_service.
LLM_INSIGHT_MODEL=claude-haiku-4-5-20251001
