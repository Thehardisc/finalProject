# InnerLink Fleet Configuration — EXAMPLE FILE
# Copy this to .env and fill in your values before running `./start.sh`
# The .env file is gitignored and must NEVER be committed.

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=TEXT

# Security
# Generate with: python -c "import secrets; print('il-' + secrets.token_urlsafe(16))"
INTERNAL_API_KEY=your-strong-random-key-here

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# Training Config
RETRAIN_INTERVAL_SECONDS=1800
ACCURACY_GATE=0.40
MAX_SAMPLES=2500
MODEL_PATH=/app/models/meta_weights.pkl

# LLM Settings
# Options: RULE_BASED (default), OPENAI, GROQ
LLM_PROVIDER=RULE_BASED
